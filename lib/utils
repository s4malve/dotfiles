#!/bin/bash

log_info() {
	echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
	echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
	echo -e "${YELLOW}[WARNING]${NC} $1"
}

exists() {
        if command -v -- "$@" >/dev/null 2>&1; then
		return 0
        else
		return 1
        fi
}

log_error() {
	local tag="[ERROR]"
	local tag_length_padding=$((${#tag} + 1))
	local pad=$(printf "%*s" $((tag_length_padding)) "")
	local first_msg=$1
	shift

	echo "$tag_length_padding"

	echo -e "${RED}$tag${NC} $first_msg"
	for msg in "$@"; do
		printf "%s%s\n" "$pad" "$msg"
	done
}

core_install() {
	sudo pacman -S --noconfirm --needed $@
}

external_install() {
	paru -S --noconfirm --needed $@
}

create_module() {
	template_dir="$DOTFILES_DIR/templates/new-module"
	modules=("$@")

	for module in "${modules[@]}"; do 
		log_info "'$module' module creation starts."
		module_dir="$MODULES_DIR/$module"
		mkdir -p "$module_dir"

		for template_path in "$template_dir"/*; do 
			filename="${template_path##*/}"
			path="$module_dir/$filename"

			if [[ ! -e "$path" ]]; then
				cp -r "$template_path" "$path"
			fi
		done

		log_success "'$module' module creation finish."
	done

	log_success "Module creation finished. ${#modules[@]} module(s) created."
}

# Resolve module dependencies using topological sort
resolve_dependencies() {
	local modules=("$@")
	local resolved=()
	local temp_mark=()
	local perm_mark=()

	# Simple dependency resolution (you can make this more sophisticated)
	# For now, just process in order and add dependencies first
	local all_deps=()

	for module in "${modules[@]}"; do
		if [[ -f "$MODULES_DIR/$module/$DEPENDENCIES_FILE_NAME" ]]; then
			while IFS= read -r dep; do
				[[ -n "$dep" && "$dep" != \#* ]] && all_deps+=("$dep")
				done < "$MODULES_DIR/$module/$DEPENDENCIES_FILE_NAME"
		fi
		all_deps+=("$module")
	done

	# Remove duplicates while preserving order
	printf '%s\n' "${all_deps[@]}" | awk '!seen[$0]++'
}

run_module_script() {
	local module="$1"
	local script_type="$2"
	local script_path="$MODULES_DIR/$module/${script_type}"

	if [[ -f "$script_path" ]]; then
		log_info "Running $script_type for $module"
		if ! bash "$script_path"; then
			log_error "Failed to run $script_type for $module"
			exit 1
		fi
	else
		log_warning "No $script_type script found for $module"
	fi
}

# Link configuration files
link_config() {
	local source="$1"
	local target="$2"

	# Create target directory if it doesn't exist
	mkdir -p "$(dirname "$target")"

	# Backup existing file if it exists and isn't a symlink
	if [[ -f "$target" && ! -L "$target" ]]; then
		log_warning "Backing up existing $target to ${target}.backup"
		mv "$target" "${target}.backup"
	fi

	# Create symlink
	ln -sf "$source" "$target"
	log_info "Linked $source -> $target"
}

prompt_for_yes_no() {
    local prompt_msg="$1"
    local default_choice="${2:-no}" # Default to 'no' if not provided
    local choice_lower

    while true; do
        read -rp "$prompt_msg ($default_choice)? " choice
        choice_lower=$(echo "$choice" | tr '[:upper:]' '[:lower:]') # Convert to lowercase

        case "$choice_lower" in
            y|yes) return 0 ;; # Success (yes)
            n|no) return 1 ;;  # Failure (no)
            "")
                if [[ "$default_choice" == "yes" ]]; then
                    return 0
                else
                    return 1
                fi
                ;;
            *) echo "Invalid option. Please enter 'yes' or 'no'." ;;
        esac
    done
}
